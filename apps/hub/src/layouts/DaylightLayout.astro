---
import '@shared/styles/global.css';
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import SiteDoorBar from '../components/layout/SiteDoorBar';
import AuthModal from '../components/billing/AuthModal.tsx';
import PwaRegister from '../components/tools/PwaRegister';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'GramSevaMitra owner check. No sign-in. The file stays on this device.' } = Astro.props;
---

<BaseLayout title={title} description={description} site="hub">
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
      <div class="flex items-center justify-between px-4 py-3">
        <a href="/" class="text-lg font-black text-slate-900">GramSevaMitra</a>
        <a href="/workspace/finance/" class="text-sm font-bold text-slate-700">Finance Hub</a>
      </div>
      <SiteDoorBar client:load tone="daylight" />
    </header>
    <slot />
  </div>
  <AuthModal client:load />
  <PwaRegister client:load />
</BaseLayout>

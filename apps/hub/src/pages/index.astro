---
/**
 * Capacitor-safe root entry.
 * Do not use Astro.redirect() — static builds bake absolute https:// URLs that
 * Android treats as external intents and opens in Chrome.
 * No imports here so Vite does not inject extra assets into this shell page.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Loading…</title>
    <script is:inline>
      window.location.replace('/workspace/documents/');
    </script>
  </head>
  <body></body>
</html>

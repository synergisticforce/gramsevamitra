---
/**
 * Capacitor-safe root entry. This is also the PWA `start_url`, so it must
 * declare the manifest and theme colour for installability.
 *
 * Target the explicit HTML file — directory URLs without a server often 404
 * in the Android WebView asset loader and produce a black screen.
 */
const target = '/workspace/documents/index.html';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-192.png" />
    <title>GramsevaMitra</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>
      Opening GramsevaMitra… <a href={target}>Continue</a>
    </p>
  </body>
</html>

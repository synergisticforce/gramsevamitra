---
/**
 * Capacitor-safe root entry.
 * Target the explicit HTML file — directory URLs without a server often 404
 * in the Android WebView asset loader and produce a black screen.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Loading…</title>
    <script is:inline>
      window.location.replace('/workspace/documents/index.html');
    </script>
  </head>
  <body></body>
</html>

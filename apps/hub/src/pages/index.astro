---
import { DEFAULT_APP_WORKSPACE } from '../config/appWorkspaces';

/**
 * Relative client redirect only.
 * Astro's static `Astro.redirect()` bakes absolute `https://gramsevamitra.com/...`
 * URLs into index.html, which Capacitor treats as external and opens in Chrome.
 */
const target = `${DEFAULT_APP_WORKSPACE.href}/`.replace(/\/{2,}/g, '/');
const signIn = Astro.url.searchParams.get('signIn');
const returnTo = Astro.url.searchParams.get('returnTo');

let href = target;
if (signIn === '1') {
  const params = new URLSearchParams();
  params.set('signIn', '1');
  if (returnTo && returnTo.startsWith('/') && !returnTo.startsWith('//')) {
    params.set('returnTo', returnTo);
  }
  href = `${target}?${params.toString()}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${href}`} />
    <title>GramsevaMitra</title>
    <script is:inline define:vars={{ href }}>
      window.location.replace(href);
    </script>
  </head>
  <body>
    <p>
      <a href={href}>Continue to GramsevaMitra</a>
    </p>
  </body>
</html>

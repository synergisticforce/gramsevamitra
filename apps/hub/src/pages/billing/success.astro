---
import AppShellLayout from '../../layouts/AppShellLayout.astro';
import { formatSeoTitle } from '@shared/config/seo';

const pageTitle = formatSeoTitle('Welcome to Pro', 'GramSeva Mitra');
---

<AppShellLayout title={pageTitle} description="Your GramSeva Mitra Pro subscription is being activated." activeWorkspace="documents">
  <div class="px-4 py-12 text-center sm:px-6 sm:py-16">
    <p class="text-5xl" aria-hidden="true">⚡</p>
    <h1 class="mt-4 text-2xl font-bold text-canvas-text sm:text-3xl">Payment successful</h1>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-canvas-muted">
      Thank you! Razorpay confirmed your payment. Your account will show Pro within a few seconds once our
      webhook confirms your Pro status.
    </p>
    <p id="session-hint" class="mt-4 text-xs font-medium leading-relaxed text-slate-300"></p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href="/workspace/documents"
        class="inline-flex items-center justify-center rounded-lg bg-canvas-accent-muted px-4 py-2.5 text-sm font-semibold text-canvas-text transition hover:bg-canvas-elevated"
      >
        Back to app
      </a>
      <a
        href="/workspace/documents"
        class="inline-flex items-center justify-center rounded-lg border border-canvas-border bg-canvas-surface px-4 py-2.5 text-sm font-semibold text-canvas-muted transition hover:bg-canvas-elevated"
      >
        Open Document Studio
      </a>
    </div>
  </div>
</AppShellLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const paymentId =
    params.get('payment_id') ||
    params.get('razorpay_payment_id');
  const orderId =
    params.get('order_id') ||
    params.get('razorpay_order_id');
  const signature =
    params.get('signature') ||
    params.get('razorpay_signature');
  const hint = document.getElementById('session-hint');

  async function confirmIfPossible() {
    if (!paymentId || !orderId || !signature) {
      if (hint && (paymentId || orderId)) {
        const parts = [];
        if (paymentId) parts.push(`Payment: ${paymentId.slice(0, 20)}…`);
        if (orderId) parts.push(`Order: ${orderId.slice(0, 20)}…`);
        hint.textContent = parts.join(' · ');
      }
      return;
    }

    if (hint) hint.textContent = 'Confirming Pro on your account…';
    try {
      const response = await fetch('/api/billing/verify-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ orderId, paymentId, signature }),
      });
      const result = await response.json();
      if (hint) {
        if (result.proActive || result.alreadyPro) {
          hint.textContent = 'Pro is active on your account. You can return to the app.';
        } else {
          hint.textContent = result.error || 'Waiting for webhook confirmation…';
        }
      }
    } catch {
      if (hint) hint.textContent = 'Waiting for webhook confirmation…';
    }
  }

  confirmIfPossible();
</script>

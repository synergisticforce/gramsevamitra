---
import { SITES } from '../config/sites';
import { canonicalUrl, getRobotsDirective } from '../config/seo';
import PostHogAnalytics from '../components/PostHogAnalytics.astro';

interface Props {
  title: string;
  description?: string;
  site?: 'hub' | 'optimizer' | 'resume' | 'pdf';
}

const {
  title,
  description = 'Privacy-first document and productivity tools for professionals, students, and creators worldwide.',
  site = 'hub',
} = Astro.props;

const siteConfig = SITES[site];
const canonical = canonicalUrl(site, Astro.url.pathname);
const robots = getRobotsDirective();
const ogImage = new URL('/favicon.svg', siteConfig.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Gramseva" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-192.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GramSeva Mitra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
    {site === 'hub' && (
      <script is:inline define:vars={{ buildId: 'DAY-ZERO-V8' }}>
        (function () {
          try {
            var key = 'gsm-sw-purge';
            if (localStorage.getItem(key) === buildId) return;
            localStorage.setItem(key, buildId);
            if ('serviceWorker' in navigator) {
              navigator.serviceWorker.getRegistrations().then(function (regs) {
                regs.forEach(function (reg) {
                  reg.unregister();
                });
              });
            }
            if ('caches' in window) {
              caches.keys().then(function (keys) {
                keys.forEach(function (name) {
                  caches.delete(name);
                });
              });
            }
          } catch (_) {
            /* storage blocked */
          }
        })();
      </script>
    )}
    <PostHogAnalytics />
    {/* On-device Eruda console — bundled first (works offline in Capacitor APK). */}
    {site === 'hub' && (
      <>
        <script is:inline src="/eruda.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/eruda"></script>
        <script is:inline>
          (function () {
            try {
              if (typeof eruda !== 'undefined' && !window.__GSM_ERUDA__) {
                eruda.init();
                window.__GSM_ERUDA__ = true;
                console.log('[Gramseva] Eruda console ready — tap the floating gear');
              }
            } catch (err) {
              console.error('ERUDA_INIT_FAILED', err);
            }
            window.addEventListener('error', function (e) {
              console.error('GLOBAL_ERROR:', e.message, e.filename, e.lineno);
            });
            window.addEventListener('unhandledrejection', function (e) {
              console.error('UNHANDLED_REJECTION:', e.reason);
            });
          })();
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen bg-canvas-bg text-slate-200 leading-relaxed antialiased">
    <slot />
  </body>
</html>
